{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "checkJs": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "server.js", "migrate-mongo-config.js"],
  "exclude": ["node_modules", "dist"]
}
