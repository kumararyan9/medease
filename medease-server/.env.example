# Server
PORT=8000
NODE_ENV=development

# DNS — override Node.js DNS servers (fixes SRV lookup on VPN/corporate networks)
DNS_SERVERS=10.217.20.129,8.8.8.8

# MongoDB — replace with your Atlas connection string
MONGODB_URI=YOUR_MONGODB_URI
DB_NAME=dev

# JWT — use a long, random string
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Admin credentials (used for first-time login)
ADMIN_EMAIL=admin@medease.in
ADMIN_PASSWORD=Admin@1234

# CORS — comma-separated origins, leave empty to allow all
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Application
MAX_USERS=100
SLOT_INTERVAL=30
WORKING_HOURS_START=10
WORKING_HOURS_END=16
